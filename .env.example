BOT_TOKEN=YOUR_BOT_TOKEN_HERE
CLIENT_ID=YOUR_APPLICATION_CLIENT_ID_HERE
GUILD_ID=YOUR_GUILD_ID_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ---------------------------------------------------------------------------
# Web dashboard
# ---------------------------------------------------------------------------
# Runs inside the bot process: http://127.0.0.1:3000
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# Set a password to require a login. Leave blank for localhost-only access.
# Required if DASHBOARD_HOST is not a loopback address.
DASHBOARD_PASSWORD=
